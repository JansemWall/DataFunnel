*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.dylib
*.dll

# C extensions / build intermediates
*.o
*.obj
*.a
*.lib

# Test, coverage and quality tools
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.pyre/
.ruff_cache/
.hypothesis/
.dmypy.json
dmypy.json
.cache/

# Type checker / linters
.pytype/

# Logs
*.log
logs/

